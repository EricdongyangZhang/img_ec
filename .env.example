# ===== GLM-Image 生图 API =====
# 在智谱开放平台 https://bigmodel.cn/usercenter/proj-mgmt/apikeys 获取
GLM_API_KEY=

# 接口地址（一般不用改）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
GLM_MODEL=glm-image

# 生成参数
# 尺寸可选：1280x1280(主图) / 1088x1472(3:4商品图) / 1568x1056 等
IMAGE_SIZE=1280x1280
IMAGE_QUALITY=hd
# 关闭水印需在智谱开放平台「个人中心-安全管理-去水印管理」签署免责声明
WATERMARK_ENABLED=false
# 每次生成的候选图数量
NUM_CANDIDATES=3

# ===== 微信通道 =====
# 监听的会话名称（发给"文件传输助手"即触发）
LISTEN_CHAT=文件传输助手

# ===== 输出目录 =====
OUTPUT_DIR=output
